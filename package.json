{
  "name": "dsh-wander-chat",
  "version": "0.1.0",
  "description": "DSH 插件：在侧边栏「新会话」下方新增「新建漫游会话」，一键在不选择本地目录的情况下开会话，所有漫游会话统一归入一个可配置的固定工作区。",
  "license": "MIT",
  "author": "helloHupc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helloHupc/dsh-wander-chat.git"
  },
  "homepage": "https://github.com/helloHupc/dsh-wander-chat#readme",
  "bugs": {
    "url": "https://github.com/helloHupc/dsh-wander-chat/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "bundle",
    "workspace",
    "session",
    "sidebar"
  ],
  "type": "module",
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
